def top_my_tracklist(my_tracklist, likes, limit):
    combined = []

    for i in range(len(my_tracklist)):
        combined.append((my_tracklist[i], likes[i]))

    combined.sort(key=lambda x: x[1], reverse=True)
    return combined[:limit]

