def process_users(users):    #---------------------- automation tool   Batch Processing 
    results = []             #-------------------------------------------------------------

    for user in users:
        results.append(user.upper())

    return results

def validate_usernames(usernames):                 # automation tool Validation Automation
    valid = []

    for name in usernames:
        if len(name) >= 3 and " " not in name:
            valid.append(name)

    return valid

def find_inactive_users(users, login_counts, threshold):    # automation tool Filtering and Alerts
    inactive = []

    for i in range(len(users)):
        if login_counts[i] < threshold:
            inactive.append(users[i])

    return inactive


def top_performers(names, scores, limit):          # Automation tool Ranking and Reporting 
    combined = []

    for i in range(len(names)):
        combined.append((names[i], scores[i]))

    combined.sort(key=lambda x: x[1], reverse=True)
    return combined[:limit]



def daily_cleanup(logs):                          # Automation tool Automation tasks 
    cleaned = []

    for log in logs:
        if "ERROR" not in log:
            cleaned.append(log)

    return cleaned

def normalize_emails(emails):                    # Automation tool Automation Pipline  list - in list - out 
    normalized = []

    for email in emails:
        normalized.append(email.strip().lower())

    return normalized


def flag_users(users, reports):               # Automation tool Automation Triggers if this - than that logic 
    flagged = []

    for i in range(len(users)):
        if reports[i] >= 3:
            flagged.append(users[i])

    return flagged



